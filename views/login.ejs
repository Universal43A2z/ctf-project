<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>F1 StackMind — Login</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/theme.js"></script>
</head>
<body class="login-page">
  <section class="hero">
    <!-- Background Shapes -->
    <div class="circle circle-1"></div>
    <div class="circle circle-2"></div>
    <div class="circle circle-3"></div>

    <!-- Navigation -->
    <nav>
      <div class="logo">
        <img src="/logo.png" alt="F1 STACKMIND" class="logo-img">
      </div>

      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/ctf">Challenges</a></li>
        <li><a href="/login">Login</a></li>
        <li>
          <button id="themeToggle" class="theme-toggle" aria-label="Toggle light or dark mode"></button>
        </li>
      </ul>
    </nav>

    <!-- Main Content -->
    <div class="hero-content">

      <!-- Left Side -->
      <div class="hero-text">
        <h1>Cyber.</h1>

        <h2>Capture The Flag Platform</h2>

        <p class="description">
          Welcome to the Cyber CTF series &mdash; test your skills against a
          collection of hands-on cybersecurity challenges. Crack ciphers,
          inspect files, and dig through the web for hidden flags. Every solve
          earns points; climb the leaderboard and prove your place among the
          best. New challenges in crypto, stego, web, OSINT, and more.
        </p>

        <a href="/ctf" class="learn-more">LEARN MORE</a>

        <div class="dots">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot active"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      </div>

      <!-- Login Form -->
      <div class="login-container">
        <div class="login-title">
          PLAYER <span>LOGIN</span>
        </div>

        <% if (error) { %>
          <div class="alert error"><%= error %></div>
        <% } %>

        <form method="POST" action="/login" autocomplete="off">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="input-group">
            <div class="input-icon">
              <svg width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.8">
                <circle cx="12" cy="7" r="4"/>
                <path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>
              </svg>
            </div>

            <input
              type="text"
              id="username"
              name="username"
              placeholder="ENTER USERNAME"
              required
              autocomplete="off"
              spellcheck="false"
              autofocus
            >
          </div>

          <div class="input-group">
            <div class="input-icon">
              <svg width="35" height="35" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="1.8">
                <rect x="4" y="10" width="16" height="11" rx="1"/>
                <path d="M8 10V7a4 4 0 0 1 8 0v3"/>
                <circle cx="12" cy="15" r="1"/>
                <path d="M12 16v2"/>
              </svg>
            </div>

            <input
              type="password"
              id="password"
              name="password"
              placeholder="ENTER PASSWORD"
              required
              autocomplete="new-password"
            >
          </div>

          <button type="submit" class="login-btn">LOGIN</button>
        </form>

        <p class="login-alt">Accounts are issued by the event organizer.</p>
      </div>

    </div>
  </section>
</body>
</html>